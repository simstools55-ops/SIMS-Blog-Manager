{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SIMS_DOCTOR_SINGLE_CASE_REQUEST_V2.schema.json",
  "title": "SIMS Doctor Single Case Request V2",
  "type": "object",
  "required": [
    "format",
    "contract_version",
    "site",
    "request",
    "article",
    "evidence_package",
    "return_contract"
  ],
  "properties": {
    "format": {
      "const": "SIMS_DOCTOR_SINGLE_CASE_REQUEST_V2"
    },
    "contract_version": {
      "const": "2.0"
    },
    "schema_version": {
      "const": "2.3.0"
    },
    "site": {
      "type": "object",
      "required": [
        "site_id",
        "site_name",
        "blog_url"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "request_id",
        "consultation_mode"
      ]
    },
    "article": {
      "type": "object",
      "required": [
        "article_id",
        "url"
      ]
    },
    "evidence_package": {
      "type": "object",
      "required": [
        "package_format",
        "package_version",
        "evidence_index",
        "evidence_validation",
        "doctor_readiness",
        "search_console"
      ],
      "properties": {
        "package_format": {
          "const": "SIMS_DOCTOR_EVIDENCE_PACKAGE_V2"
        },
        "package_version": {
          "const": "2.3.0"
        },
        "evidence_index": {
          "type": "array"
        },
        "search_console": {
          "type": "object"
        },
        "evidence_validation": {
          "type": "object",
          "required": [
            "overall",
            "evidence_score",
            "counts",
            "checks"
          ]
        },
        "doctor_readiness": {
          "type": "object",
          "required": [
            "status",
            "label",
            "diagnosis_allowed"
          ]
        },
        "compatible_with": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "site_impact": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "evidence_role": {
              "type": "string"
            },
            "periods": {
              "type": "object"
            },
            "metrics": {
              "type": "object"
            },
            "article_population": {
              "type": "object"
            },
            "collection": {
              "type": "object"
            },
            "confidence": {
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "return_contract": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "schema_version": null
}
